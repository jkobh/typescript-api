{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortPackageJson": true,
  "ignorePatterns": ["node_modules/**", "pnpm-lock.yaml", "certs/**"]
}